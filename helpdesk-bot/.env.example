# Pick ONE of the three provider blocks below. The demo's chat-client
# factory selects between them purely based on which env vars are set.
# Stronger models are usually more reliable both at *executing* the
# attack (red) and *resisting* it after the patch (green). gpt-4o is a
# good balance of cost and tool-calling reliability.

# ---------------------------------------------------------------------
# Option A — OpenAI direct (no Microsoft tenant required)
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------
# Option B — Azure OpenAI with API key
# ---------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<key>
# AZURE_OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------
# Option C — Azure OpenAI with Entra ID (DefaultAzureCredential)
# ---------------------------------------------------------------------
# Install the optional dependency first:
#   pip install -e '.[azure]'
# Then sign in with `az login` (or any other identity DefaultAzureCredential
# can find: VS Code, managed identity, environment, etc.) and set:
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_MODEL=gpt-4o
# AZURE_OPENAI_USE_AZURE_CREDENTIAL=true
